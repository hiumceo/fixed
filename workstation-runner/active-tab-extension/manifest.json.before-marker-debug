{
  "manifest_version": 3,
  "name": "v1124 Active Tab Bridge",
  "version": "1.2.0",
  "description": "Reports the browser's actually selected tab to the v1124 workstation runner.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:18724/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
